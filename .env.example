# LLM Mode: "auto" (uses OpenAI-compatible API if OPENAI_API_KEY is set, else MockLLMClient), "openai", or "mock"
LLM_MODE=auto

# OpenAI-Compatible Endpoint Configuration (supports OpenAI, DeepSeek-V3, Qwen-Plus, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Runtime Guardrails & Token Budget
REACT_MAX_STEPS=10
REACT_MAX_CONTEXT_TOKENS=3200
REACT_KEEP_RECENT_GROUPS=3
REACT_MAX_SELF_HEAL_RETRIES=3

# MCP Security Policy: "ALLOW_READ" | "REQUIRE_APPROVAL" | "DENY"
MCP_WRITE_POLICY=REQUIRE_APPROVAL
